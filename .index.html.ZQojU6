KR_TIER_DATA.forEach(group=>Object.values(group.tiers).forEach(items=>items.forEach(item=>{
 if(KR_TIER_NAME_FIXES[item.name]) item.name=KR_TIER_NAME_FIXES[item.name];
 if(group.section==='탐험대 - 강적 출현(길드전)'&&group.role==='돌격'&&item.name==='레니시아') item.name='레티시아';
 if(group.section==='종합'&&group.role==='돌격'&&item.name==='필리아') item.name='필데나';
 if(group.section==='탐험대 - 강적 출현(길드전)'&&group.role==='수호'&&item.name==='비') item.name='카구야';
 if(group.section==='탐험대 - 강적 출현(길드전)'&&group.role==='언령'&&item.name==='필데나') item.name='필리아';
})));
const CHARACTER_DISPLAY_NAME_FIXES={라스트:'러스트'};
[...CN_TIER_DATA,...KR_TIER_DATA].forEach(group=>Object.values(group.tiers).forEach(items=>items.forEach(item=>{if(item.name==='라스트') item.name='러스트';})));
KR_TIER_DATA.forEach(group=>{
 if(group.section==='PVP - 경기장') return;
 const ranks=group.rankOrder||['T0','T1','T2','T3'];
 const fromIndex=ranks.findIndex(rank=>(group.tiers[rank]||[]).some(item=>item.name==='에스텔'));
 if(fromIndex<0||fromIndex>=ranks.length-1) return;
 const from=group.tiers[ranks[fromIndex]];
 const itemIndex=from.findIndex(item=>item.name==='에스텔');
 const [item]=from.splice(itemIndex,1);
 group.tiers[ranks[fromIndex+1]].unshift(item);
});
const KR_TIER_NOTES = [
 '물속성 DOT 파티는 위의 종합 티어표와 PVE 티어표 순위에 포함하지 않습니다.',
 '위 티어표에 나오지 않은 나머지 캐릭터는 모두 T4이며, 육성을 권장하지 않습니다.',
 '물 DOT 파티 고정 멤버: 베티아, 에셀, 수플레, 티미 + 추가 멤버 구성: 유동 멤버 2명 + 힐러 1명 + 리더 스킬 담당 1명',
 '추가 멤버: 아스트레아, 미암, 아만사, 스카이라, 레니시아 + 맨디, 사이코, 고사 + 미하엘, 델리스'
];
let activeTierServer='cn';
let activeKrTierSection='종합';


function esc(v){return String(v ?? '').replace(/[&<>"]/g, s=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[s]));}
function cleanBadgeName(v){return String(v||'').replace(/^(대체|상황별)\s*/,'').trim();}
function badgeKo(raw){
 if(!raw) return '미확인';
 return String(raw);
}
function statusClass(s){
 if((s||'').includes('원문') || (s||'').includes('상세') || (s||'').includes('한국 서버 기준')) return 'ok';
 if((s||'').includes('요약') || (s||'').includes('역할')) return 'mid';
 if((s||'').includes('임시') || (s||'').includes('상황')) return 'warn';
 return 'bad';
}
function jobFrom(c){
 const valid = ['수호','돌격','언령','사수'];
 const candidates = [
  c.helperClass,
  c.detail?.job,
  c.role
 ];
 for (const v of candidates) {
  const value = String(v || '').trim().replace('연령', '언령');
  if (valid.includes(value)) return value;
 }
 return '미확인';
}
function elementFrom(c){ return c.detail?.attr || c.element || '미확인'; }
function statusFrom(c, mode){ return mode==='skill' ? (c.detail ? '상세 입력' : '미입력') : (c.status || '미확인'); }
function recHtml(c){ return (c.rec||[]).map(r=>`<span class="rec-pill">${esc(badgeKo(r))}</span>`).join('') || '<span class="rec-pill">미확인</span>'; }
function tagHtml(text, cls=''){ return `<span class="tag ${cls}">${esc(text)}</span>`; }
function rarityOf(c){ const r=Number(c&&c.rarity); return [1,2,3,4,5].includes(r)?r:0; }
function rarityLabel(c){ const r=rarityOf(c); return r?`${r}성`:'미확인'; }
function rarityClass(c){ const r=rarityOf(c); return r?`rarity-${r}`:'rarity-unknown'; }
function displayName(c){ const name=CHARACTER_DISPLAY_NAME_FIXES[c.nameKo]||c.nameKo; return c.released===false?`${name} (미출시)`:name; }
function releaseHtml(c){ return c.released ? tagHtml('한국 출시','ok') : ''; }
const IMAGE_DATA = {"가리아":"data:image/png;base64,","고스트사무라이":"data:image/png;base64,","고스트퀸":"data:image/png;base64,","네리사":"data:image/png;base64,","네뷸라":"data:image/png;base64,","니키타":"data:image/png;base64,","델리스":"data:image/png;base64,","란":"data:image/png;base64,","럼":"data:image/png;base64,","레나":"data:image/png;base64,","레미":"data:image/png;base64,","레베카":"data:image/png;base64,","레티시아":"data:image/png;base64,","렉시":"data:image/png;base64,","렛푸":"data:image/png;base64,","로빈":"data:image/png;base64,","로아":"data:image/png;base64,","루루":"data:image/png;base64,","루미아":"data:image/png;base64,","리바":"data:image/png;base64,","리온":"data:image/png;base64,","마르코":"data:image/png;base64,","맨디":"data:image/png;base64,","모니카":"data:image/png;base64,","몬나":"data:image/png;base64,","미암":"data:image/png;base64,","미하엘":"data:image/png;base64,","바렛사":"data:image/png;base64,","베티아":"data:image/png;base64,","비":"data:image/png;base64,","사이코":"data:image/png;base64,","세그레타":"data:image/png;base64,","세그리타":"data:image/png;base64,","세키":"data:image/png;base64,","수지":"data:image/png;base64,","수플레":"data:image/png;base64,","쉬엘":"data:image/png;base64,","스카이라":"data:image/png;base64,","아그니스":"data:image/png;base64,","아네시":"data:image/png;base64,","아리아":"data:image/png;base64,","아만사":"data:image/png;base64,","아스트레아":"data:image/png;base64,","안렌":"data:image/png;base64,","안리스":"data:image/jpeg;base64,","안리시":"data:image/png;base64,","알리시스":"data:image/png;base64,","애그니스":"data:image/png;base64,","에밀리":"data:image/png;base64,","에셀":"data:image/png;base64,","에스텔":"data:image/png;base64,","엠마":"data:image/png;base64,","오스틴":"data:image/png;base64,","오페라":"data:image/png;base64,","오필리아":"data:image/png;base64,","운라":"data:image/png;base64,","이네리스":"data:image/png;base64,","이클립스":"data:image/png;base64,","재스민":"data:image/png;base64,","제시카":"data:image/png;base64,","젬마":"data:image/png;base64,","집례자":"data:image/png;base64,","카구야":"data:image/png;base64,","카이사":"data:image/png;base64,","쿠키":"data:image/png;base64,","테오스트라":"data:image/png;base64,","테킬라":"data:image/png;base64,","티나":"data:image/png;base64,","티미":"data:image/png;base64,","푸광":"data:image/png;base64,","프레이야":"data:image/png;base64,","플라크":"data:image/png;base64,","피니스":"data:image/png;base64,","필데나":"data:image/png;base64,","필리아":"data:image/png;base64,","하이디":"data:image/png;base64,","플레어":"data:image/jpeg;base64,","가디언":"data:image/jpeg;base64,","고스트킹":"data:image/jpeg;base64,","킹":"data:image/jpeg;base64,","나이팅게일":"data:image/jpeg;base64,","노마":"data:image/jpeg;base64,","라스트":"data:image/jpeg;base64,","레네시아":"data:image/jpeg;base64,","레이븐":"data:image/jpeg;base64,","마들렌":"data:image/jpeg;base64,","메이":"data:image/jpeg;base64,","미스트":"data:image/jpeg;base64,","성광사":"data:image/jpeg;base64,","셜리":"data:image/jpeg;base64,","셰리":"data:image/jpeg;base64,","스텔라":"data:image/jpeg;base64,","아네모스":"data:image/jpeg;base64,","아울":"data:image/jpeg;base64,","에이야":"data:image/jpeg;base64,","엘라":"data:image/jpeg;base64,","이자벨":"data:image/jpeg;base64,","페이":"data:image/jpeg;base64,","사회자":"data:image/png;base64,","윤루오":"data:image/png;base64,","플로링 라이트":"data:image/png;base64,","아그네스":"data:image/png;base64,","릴리스":"data:image/png;base64,","마리나":"data:image/png;base64,","사를라":"data:image/png;base64,"};
IMAGE_DATA['렌']='data:image/png;base64,';
IMAGE_DATA['시키']='data:image/jpeg;base64,';
IMAGE_DATA['고스트']='data:image/png;base64,';
IMAGE_DATA['위스키']='data:image/png;base64,';
IMAGE_DATA['유나']='data:image/png;base64,';
function cleanImageKey(v){ return String(v||'character').replace(/[\/:*?"<>|]/g,'_').replace(/\s+/g,'_'); }
function imageKey(c){ return cleanImageKey((c && (c.imageName || c.nameKo)) || 'character'); }
function imageBaseByKey(k){ return 'assets/characters/' + cleanImageKey(k); }
function imageBase(c){ return imageBaseByKey(imageKey(c)); }
function imageFile(c){ return imageSrc(c); }
function imageSrcByKey(k){
 const raw = String(k || 'character').trim();
 const key = cleanImageKey(raw);
 const spaced = raw.replace(/_/g,' ');
 const underscored = raw.replace(/\s+/g,'_');
 const variants = [raw, key, spaced, cleanImageKey(spaced), underscored, cleanImageKey(underscored)];
 for(const v of variants){
  if(IMAGE_DATA[v]) return IMAGE_DATA[v];
 }
 return imageBaseByKey(key) + '.png';
}
function imageSrc(c){ return imageSrcByKey((c && (c.imageName || c.nameKo)) || 'character'); }
function initialText(c){ return String(c.nameKo || '?').replace(/\s/g,'').slice(0,1) || '?'; }
function imgFallback(img){
 const exts=['.png','.jpg','.jpeg','.webp'];
 if(String(img.src||'').startsWith('data:')){
  img.style.display='none';
  const ph=img.nextElementSibling; if(ph) ph.style.display='grid';
  return;
 }
 const next=(Number(img.dataset.try||0)+1);
 if(next < exts.length){ img.dataset.try=String(next); img.src=img.dataset.base + exts[next]; return; }
 img.style.display='none';
 const ph=img.nextElementSibling; if(ph) ph.style.display='grid';
}
function thumbHtml(c){ const base=imageBase(c); const src=imageSrc(c); return `<div class="char-thumb ${rarityClass(c)}"><img src="${esc(src)}" data-base="${esc(base)}" data-try="0" alt="${esc(displayName(c))}" onerror="imgFallback(this)"><span>${esc(initialText(c))}</span></div>`; }
function portraitHtml(c){ const base=imageBase(c); const src=imageSrc(c); return `<div class="detail-portrait ${rarityClass(c)}"><img src="${esc(src)}" data-base="${esc(base)}" data-try="0" alt="${esc(displayName(c))}" onerror="imgFallback(this)"><span>${esc(initialText(c))}</span></div>`; }

function roleGroupsFrom(c){
 const raw=String(c.helperRoles||'미확인');
 const list=raw.split(/[\/,]/).map(v=>v.trim()).filter(Boolean);
 return list.length ? list : ['미확인'];
}
function roleGroupText(c){ return roleGroupsFrom(c).join(', '); }
function fillSelects(){
 const jobs=[...new Set(CHARACTERS.map(jobFrom))].sort();
 const statuses=[...new Set(CHARACTERS.map(c=>c.status||'미확인'))].sort();
 const skillStatuses=['상세 입력','미입력'];
 const elements=['빛','암','화','수','목','미확인'].filter(v=>CHARACTERS.some(c=>elementFrom(c)===v));
 const rarities=[5,4,3,2,1].filter(r=>CHARACTERS.some(c=>rarityOf(c)===r)).map(r=>({value:String(r), text:`${r}성`}));
 const badgeNames=Object.entries(BADGES).filter(([k])=>k!=='미확인').map(([name,b])=>({value:name, text:name}));
 const roleGroupOrder=['탱커','힐러','서포터','딜러'];
 const roleGroups=roleGroupOrder.filter(v=>CHARACTERS.some(c=>roleGroupsFrom(c).includes(v)));
 const utilStop=new Set(['미확인','유틸리티','단일','광역','지속']);
 const utilities=[...new Set(CHARACTERS.flatMap(c=>String(c.tags||c.utility||'').split(',').map(v=>v.trim()).filter(v=>v && !utilStop.has(v))))].sort();
 function addOptions(id, arr){ const el=$(id); if(!el) return; arr.forEach(v=>{const o=document.createElement('option'); o.value=typeof v==='object'?v.value:v; o.textContent=typeof v==='object'?v.text:v; el.appendChild(o);}); }
 addOptions('#badgeJob', jobs); addOptions('#skillJob', jobs);
 addOptions('#badgeStatus', statuses); addOptions('#skillStatus', statuses);
 addOptions('#badgeElement', elements); addOptions('#skillElement', elements);
 addOptions('#badgeRarity', rarities);
 addOptions('#badgeBadge', badgeNames);
 addOptions('#badgeRoleGroup', roleGroups); addOptions('#skillRoleGroup', roleGroups);
 addOptions('#badgeUtility', utilities); addOptions('#skillUtility', utilities);
}
function filter(mode){
 const q=($(`#${mode}Search`)?.value||'').trim().toLowerCase();
 const job=($(`#${mode}Job`)?.value||'');
 const element=($(`#${mode}Element`)?.value||'');
 const status=($(`#${mode}Status`)?.value||'');
 const badge=($('#badgeBadge')?.value||'');
 const utility=($(`#${mode}Utility`)?.value||'');
 const roleGroup=($(`#${mode}RoleGroup`)?.value||'');
 const rarity=($('#badgeRarity')?.value||'');
 const detail=($('#skillDetail')?.value||'');
 const hideUnreleased=$('#hideUnreleased')?.checked;
 const onlyUnreleased=$('#onlyUnreleased')?.checked;
 return CHARACTERS.filter(c=>{
  if(onlyUnreleased && c.released) return false;
  if(!onlyUnreleased && hideUnreleased && !c.released) return false;
  const hay=[c.nameKo,c.nameCn,c.alias,c.aliases?.join?.(' '),c.role,c.element,c.status,c.rec?.join(' '),c.main,c.sub,c.note,c.source,c.detail?.leader,c.detail?.skillSummary,c.detail?.awaken,c.detail?.job,c.detail?.attr,c.utility,c.tags,c.helperRoles,c.released?'':'미출시'].filter(Boolean).join(' ').toLowerCase();
  if(q && !hay.includes(q)) return false;
  if(roleGroup && !roleGroupsFrom(c).includes(roleGroup)) return false;
  if(utility){
   const utilText=[c.utility,c.tags,c.helperRoles].filter(Boolean).join(', ');
   if(!utilText.split(',').map(v=>v.trim()).includes(utility) && !utilText.includes(utility)) return false;
  }
  if(job && jobFrom(c)!==job) return false;
  if(element && elementFrom(c)!==element) return false;
  if(status && (c.status||'미확인')!==status) return false;
  if(mode==='badge' && rarity && String(rarityOf(c))!==String(rarity)) return false;
  if(mode==='badge' && badge && !(c.badges||'').includes(badge)) return false;
  if(mode==='skill' && detail==='yes' && !c.detail) return false;
  if(mode==='skill' && detail==='no' && c.detail) return false;
  return true;
 });
}
function renderBadge(){
 activeTab='badge'; currentList=filter('badge'); $('#shownCount').textContent=currentList.length;
 const rows=currentList.map((c,i)=>`<tr data-i="${i}" class="${selectedIndex===i?'selected':''}">
  <td>${thumbHtml(c)}</td>
  <td>${esc(rarityLabel(c))}</td>
  <td class="namecell"><b>${esc(displayName(c))}</b><span>${esc(c.nameCn)}</span></td>
  <td>${tagHtml(jobFrom(c),'mid')}</td>
  <td>${esc(elementFrom(c))}</td>
  <td>${esc(roleGroupText(c))}</td>
  <td>${esc(c.utility||'미확인')}</td>
  <td>${recHtml(c)}</td>
  <td>${esc(c.starOption||'미확인')}</td>
  <td>${esc(c.main||'')}</td>
  <td>${esc(c.sub||'')}</td>
  <td>${tagHtml(c.status||'미확인',statusClass(c.status))}</td>
  <td>${esc(c.source||'')}</td>
 </tr>`).join('');
 $('#badgeTable').innerHTML=`<thead><tr><th>이미지</th><th>성급</th><th>캐릭터</th><th>직업</th><th>속성</th><th>역할군</th><th>유틸리티</th><th>추천 배지</th><th>별 옵션</th><th>깃털 옵션</th><th>우선 부옵</th><th>상태</th><th>출처</th></tr></thead><tbody>${rows || `<tr><td colspan="13" class="empty">검색 결과 없음</td></tr>`}</tbody>`;
 attachRows('#badgeTable');
}
function renderSkill(){
 activeTab='skill'; currentList=filter('skill'); $('#shownCount').textContent=currentList.length;
 const cards=currentList.map((c,i)=>`<button class="skill-gallery-card" data-i="${i}">${portraitHtml(c)}<strong>${esc(displayName(c))}</strong><span>${esc(rarityLabel(c))} · ${esc(jobFrom(c))} · ${esc(elementFrom(c))}</span></button>`).join('');
 $('#skillGallery').innerHTML=cards||`<div class="empty">검색 결과 없음</div>`;
 $$('#skillGallery [data-i]').forEach(card=>card.addEventListener('click',()=>{selectedIndex=Number(card.dataset.i);$$('#skillGallery [data-i]').forEach(x=>x.classList.remove('selected'));card.classList.add('selected');openSkillDetail(currentList[selectedIndex]);}));
}
function attachRows(tableSel){
 $$(`${tableSel} tbody tr[data-i]`).forEach(tr=>tr.addEventListener('click',()=>{
  selectedIndex=Number(tr.dataset.i);
  const c=currentList[selectedIndex];
  renderDetail(c);
  $$('.data-table tr').forEach(r=>r.classList.remove('selected'));
  tr.classList.add('selected');
 }));
}

function openSkillDetail(c){
 renderDetail(c);
 const existing=document.querySelector('#skillFullPage'); if(existing) existing.remove();
 const page=document.createElement('section'); page.id='skillFullPage'; page.className='skill-full-page';
 page.innerHTML=`<div class="skill-full-toolbar"><button id="skillBackBtn">← 캐릭터 목록으로</button><span>스킬·스탯 상세</span></div><article class="skill-full-card"><div class="detail-head">${$('#detailPanel .detail-head').innerHTML}</div><div class="detail-body">${$('#detailPanel .detail-body').innerHTML}</div></article>`;
 document.body.appendChild(page); document.body.classList.add('skill-detail-open');
 $('#skillBackBtn').addEventListener('click',closeSkillDetail);
 bindSkillLevels(c,page); window.scrollTo(0,0);
}
function closeSkillDetail(){const page=document.querySelector('#skillFullPage');if(page)page.remove();document.body.classList.remove('skill-detail-open');}
function materialName(id){return ITEM_KR_NAMES[String(id)]||'이름 미확인 성장 소재'}
