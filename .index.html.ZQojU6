Object.entries(BADGE_RECOMMENDATION_OVERRIDES).forEach(([name,values])=>{const character=CHARACTERS.find(c=>c.nameKo===name);if(character && !character.badgeGuideUpdated){Object.assign(character,values,{source:BADGE_RECOMMENDATION_SOURCE,badges:values.rec.join(', ')});if(character.detail) character.detail.source=BADGE_RECOMMENDATION_SOURCE;}});
const TEMP_NOTE_PATTERNS=[/GameKee 캐릭터별 배지 원문을 아직 확인하지 못함\.?/g,/우선 전체 목록 누락 방지용으로 등록\.?/g,/공식\/공략 원문에서 확실한 기본정보를 아직 확인하지 못함\.?/g,/캐릭터별 원문 추천이 미확인인 경우 역할\/스킬 설명 기준 임시 추천\.?/g,/검수 필요\.?/g];
CHARACTERS.forEach(character=>{let note=String(character.note||'');TEMP_NOTE_PATTERNS.forEach(pattern=>{note=note.replace(pattern,' ');});character.note=note.replace(/\s+/g,' ').trim();});
{const character=CHARACTERS.find(c=>c.nameKo==='라스트');if(character){character.aliases=[...new Set([...(character.aliases||[]),'라스트'])];character.nameKo='러스트';}}
